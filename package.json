{
  "name": "webpage-audit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server that lets an agent audit a site in a real browser",
  "license": "MIT",
  "author": "Ayush Patil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LifeAyush/webpage-audit.git"
  },
  "bugs": {
    "url": "https://github.com/LifeAyush/webpage-audit/issues"
  },
  "homepage": "https://github.com/LifeAyush/webpage-audit#readme",
  "keywords": [
    "mcp",
    "playwright",
    "accessibility",
    "audit",
    "axe"
  ],
  "bin": {
    "webpage-audit": "./bin/webpage-audit.mjs"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/refs.test.ts src/safety.test.ts src/tools-url.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "mcp-smoke": "tsx scripts/mcp-smoke.ts",
    "postinstall": "playwright install chromium"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
