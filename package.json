{
  "name": "playwright-webpage-review",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright MCP server for Cursor website-review agents",
  "scripts": {
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
